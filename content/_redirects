# Let assets & infra pass through first (before catch-all DOI redirect)
/static/*        /static/:splat        200
/content/*       /static/:splat        200
/embed.js        /embed.js             200
/favicon.ico     /static/favicon.ico   200
/robots.txt      /robots.txt           200

# This is a 200 rewrite, not a redirect. URL stays /funder/twcf
/funder/twcf      /funder/twcf.html    200
/funder/twcf/     /funder/twcf.html    200

# Send /funder/twcf/{doi} to /funder/twcf/?doi={doi}
/funder/twcf/* /funder/twcf/?doi=:splat 302

# Gates Foundation external permanent redirects
/funders/gates     https://openaccess.gatesfoundation.org/how-to-comply/share-your-paper-via-oa-works/                     301
/funders/gates/    https://openaccess.gatesfoundation.org/how-to-comply/share-your-paper-via-oa-works/                     301
/funders/gates/*   https://openaccess.gatesfoundation.org/how-to-comply/share-your-paper-via-oa-works/?doi=:splat          301

# Keep TWCF plural URL working without redirect hops (preserves ?doi)
/funders/twcf      /funder/twcf.html 200
/funders/twcf/     /funder/twcf.html 200
/funders/twcf/*    /funder/twcf/?doi=:splat 302

# Generic plural to singular (catch any old /funders/* links)
/funders/*         /funder/:splat      301

# Send deleted secondary pages to homepage
/shareyourpaper.org   / 301
/shareyourpaper.org/  / 301
/journals/icjr        / 301
/journals/icjr/       / 301
/demo                 /libraries 301
/demo/                /libraries 301
/setup                /libraries 301
/setup/               /libraries 301

# DOI-style paths (keep this last)
/:first/*        /?doi=:first/:splat   302
